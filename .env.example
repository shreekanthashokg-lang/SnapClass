# Copy to .env for local development. Set real values in your hosting dashboard for production.
# Never commit a real .env file.

# Port the Node server listens on. Most hosts (Render, Railway, Fly) set this for you.
PORT=8787

# Secret used to sign session cookies (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production; a temporary value is generated automatically in development if unset.
SESSION_SECRET=

# Where the SQLite database file is written. Must be a writable, persistent directory
# on your host (see README > Deployment for notes on ephemeral filesystems).
DATA_DIR=./server/data

# Public origin of this site, e.g. https://snapclass.yourdomain.com (no trailing slash).
# Used for the QR-code join links, canonical URL, social image, robots.txt and sitemap.xml.
SITE_URL=

# Optional. Adds a "Source code" link to the footer.
VITE_REPO_URL=

# Optional. Author profile links shown in the About section. GitHub has a default.
VITE_AUTHOR_GITHUB=
VITE_AUTHOR_LINKEDIN=
